{
  "name": "marker-brackets",
  "author": "lumine-code",
  "description": "Show matching bracket positions on the scrollbar and minimap.",
  "repository": "https://github.com/lumine-code/marker-brackets",
  "bugs": {
    "url": "https://github.com/lumine-code/marker-brackets/issues"
  },
  "keywords": [
    "overview-ruler",
    "gutter",
    "annotation",
    "decoration",
    "scrollmap",
    "minimap",
    "pair",
    "matching"
  ],
  "version": "1.0.0",
  "license": "MIT",
  "engines": {
    "atom": ">=1.100.0 <2.0.0"
  },
  "main": "./lib/main",
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "consumedServices": {
    "bracket-matcher": {
      "versions": {
        "^1.0.0": "consumeBracketMatcher"
      }
    }
  },
  "providedServices": {
    "marker.layer": {
      "versions": {
        "1.0.0": "provideMarkerLayer"
      }
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.2.2",
    "globals": "^17.7.0",
    "prettier": "^3.9.6"
  }
}
